# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Persistent Connection String
# IMPORTANT: In MongoDB Atlas -> Network Access, ensure IP 0.0.0.0/0 (Allow from Anywhere) is whitelisted so cloud hosts can connect.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/noor-tattoo-studio?retryWrites=true&w=majority

# Authentication
JWT_SECRET=supersecretjwtkeynoortattoostudio2026development
JWT_EXPIRES_IN=7d

# Allowed Client Origin (Vercel Production Domain or Localhost)
CLIENT_URL=https://noor-tattoo-studio.vercel.app

# Super Admin Initial Credentials (Only used on very first startup if no admin exists)
ADMIN_EMAIL=admin@noortattoo.com
ADMIN_PASSWORD=Admin@NoorTattoo2026!

# Optional Cloudinary CDN for external permanent image storage
# If omitted, images are automatically stored persistently inside MongoDB Atlas Media collection
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
